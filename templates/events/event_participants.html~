<!-- templates/events/event_participants.html -->
{% extends 'base.html' %}

{% block title %}Участники конкурса "{{ event.name }}" - Путь к успеху{% endblock %}

{% block page_title %}Участники конкурса "{{ event.name }}"{% endblock %}

{% block page_actions %}
    <a href="{% url 'events:list' %}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
    <a href="{% url 'events:add_participants' event.pk %}" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Добавить участников
    </a>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Информация о конкурсе</h5>
            </div>
            <div class="card-body">
                <table class="table">
                    <tr>
                        <th>Название:</th>
                        <td>{{ event.name }}</td>
                    </tr>
                    <tr>
                        <th>Описание:</th>
                        <td>{{ event.description|linebreaks }}</td>
                    </tr>
                    <tr>
                        <th>Уровень:</th>
                        <td>{{ event.get_level_display }}</td>
                    </tr>
                    <tr>
                        <th>Срок подачи заявок:</th>
                        <td>{{ event.application_deadline|date:"d.m.Y"|default:"Не указан" }}</td>
                    </tr>
                    <tr>
                        <th>Дата объявления результатов:</th>
                        <td>{{ event.result_date|date:"d.m.Y"|default:"Не указана" }}</td>
                    </tr>
                    <tr>
                        <th>Статус:</th>
                        <td>
                            {% if event.is_active %}
                                <span class="badge bg-success">Активен</span>
                            {% else %}
                                <span class="badge bg-secondary">Неактивен</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Количество участников:</th>
                        <td>
                            <span class="badge bg-primary">{{ participants_count }}</span>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Действия</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{% url 'events:add_participants' event.pk %}" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Добавить участников
                    </a>
                    <a href="{% url 'events:list' %}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Статистика</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>Всего участников:</strong> {{ participants_count }}</p>
                <p class="mb-1"><strong>С результатами:</strong>
                    {% with with_results=participants|length %}
                        {{ with_results }}
                    {% endwith %}
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Список участников</h5>
            </div>
            <div class="card-body">
                {% if participants %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>№</th>
                                    <th>Ребенок</th>
                                    <th>Студия</th>
                                    <th>Педагог</th>
                                    <th>Результат</th>
                                    <th>Дата отчета</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for participant in participants %}
                                    <tr>
                                        <td>{{ forloop.counter }}</td>
                                        <td>
                                            <strong>{{ participant.child.fio }}</strong>
                                        </td>
                                        <td>{{ participant.enrollment.studio.name }}</td>
                                        <td>{{ participant.enrollment.teacher }}</td>
                                        <td>
                                            {% if participant.result_type %}
                                                <span class="badge bg-success">{{ participant.result_type.name }}</span>
                                            {% elif participant.custom_result %}
                                                <span class="badge bg-info">{{ participant.custom_result }}</span>
                                            {% else %}
                                                <span class="badge bg-secondary">Без результата</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ participant.report_date|date:"d.m.Y" }}</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{% url 'participation:detail' participant.pk %}"
                                                   class="btn btn-sm btn-outline-info"
                                                   title="Просмотр участия">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{% url 'participation:update' participant.pk %}"
                                                   class="btn btn-sm btn-outline-warning"
                                                   title="Редактировать участие">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        В этом конкурсе пока нет участников.
                        <a href="{% url 'events:add_participants' event.pk %}">Добавьте первых участников</a>.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}