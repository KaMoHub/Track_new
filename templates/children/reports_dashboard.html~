<!-- templates/children/reports_dashboard.html -->
{% extends 'base.html' %}

{% block title %}Отчеты - Путь к успеху{% endblock %}

{% block page_title %}Аналитические отчеты{% endblock %}

{% block page_actions %}
    <div class="btn-group">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-calendar"></i> {{ current_month|date:"F" }} {{ current_year }}
        </button>
        <ul class="dropdown-menu">
            <li><span class="dropdown-item-text">Статистика за месяц:</span></li>
            <li><span class="dropdown-item-text">Участий: {{ monthly_stats.total|default:0 }}</span></li>
            <li><span class="dropdown-item-text">Детей: {{ monthly_stats.unique_children|default:0 }}</span></li>
            <li><span class="dropdown-item-text">Конкурсов: {{ monthly_stats.unique_events|default:0 }}</span></li>
        </ul>
    </div>
{% endblock %}

{% block content %}
<div class="row">
    <!-- Статистика -->
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">{{ monthly_stats.total|default:0 }}</h4>
                        <p class="card-text">Участий за месяц</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-award fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">{{ monthly_stats.unique_children|default:0 }}</h4>
                        <p class="card-text">Уникальных детей</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-people fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">{{ monthly_stats.unique_events|default:0 }}</h4>
                        <p class="card-text">Конкурсов</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-trophy fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">{{ reports|length }}</h4>
                        <p class="card-text">Доступных отчетов</p>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-file-earmark-text fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Карточки отчетов -->
<div class="row">
    {% for report in reports %}
    <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100 {% if not report.available %}opacity-75{% endif %}">
            <div class="card-header bg-{{ report.color }} text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="{{ report.icon }}"></i> {{ report.title }}
                    </h5>
                    {% if not report.available %}
                    <span class="badge bg-secondary">Скоро</span>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <p class="card-text">{{ report.description }}</p>

                {% if report.id == 2 %}
                <!-- Форма выбора месяца для отчета 2 -->
                <div class="mb-3">
                    <label for="month_{{ report.id }}" class="form-label small">Выберите месяц:</label>
                    <select class="form-select form-select-sm" id="month_{{ report.id }}">
                        <option value="1" {% if current_month == 1 %}selected{% endif %}>Январь</option>
                        <option value="2" {% if current_month == 2 %}selected{% endif %}>Февраль</option>
                        <option value="3" {% if current_month == 3 %}selected{% endif %}>Март</option>
                        <option value="4" {% if current_month == 4 %}selected{% endif %}>Апрель</option>
                        <option value="5" {% if current_month == 5 %}selected{% endif %}>Май</option>
                        <option value="6" {% if current_month == 6 %}selected{% endif %}>Июнь</option>
                        <option value="7" {% if current_month == 7 %}selected{% endif %}>Июль</option>
                        <option value="8" {% if current_month == 8 %}selected{% endif %}>Август</option>
                        <option value="9" {% if current_month == 9 %}selected{% endif %}>Сентябрь</option>
                        <option value="10" {% if current_month == 10 %}selected{% endif %}>Октябрь</option>
                        <option value="11" {% if current_month == 11 %}selected{% endif %}>Ноябрь</option>
                        <option value="12" {% if current_month == 12 %}selected{% endif %}>Декабрь</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="year_{{ report.id }}" class="form-label small">Год:</label>
                    <input type="number" class="form-control form-control-sm" id="year_{{ report.id }}"
                           value="{{ current_year }}" min="2025" max="2040">
                </div>
                {% endif %}

                <!-- templates/children/reports_dashboard.html (добавляем форму для отчета 3) -->

                {% if report.id == 3 %}
                <!-- Форма выбора полугодия для отчета 3 -->
                <div class="mb-3">
                    <label for="semester_{{ report.id }}" class="form-label small">Выберите полугодие:</label>
                    <select class="form-select form-select-sm" id="semester_{{ report.id }}">
                        <option value="1" {% if current_semester == 1 %}selected{% endif %}>1 полугодие (январь-июнь)</option>
                        <option value="2" {% if current_semester == 2 %}selected{% endif %}>2 полугодие (июль-декабрь)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="year_semester_{{ report.id }}" class="form-label small">Год:</label>
                    <input type="number" class="form-control form-control-sm" id="year_semester_{{ report.id }}"
                           value="{{ current_year }}" min="2024" max="2040">
                </div>
                {% endif %}
            </div>
            <!-- templates/children/reports_dashboard.html (исправленная часть с кнопками) -->
            <div class="card-footer">
                {% if report.available %}
                    {% if report.needs_params %}
                    <!-- Для отчетов, требующих параметров -->
                    <button class="btn btn-{{ report.color }} btn-sm w-100 download-report"
                            data-report-id="{{ report.id }}"
                            data-url="{{ report.url }}">
                        <i class="bi bi-download"></i> Выгрузить отчет
                    </button>
                    {% else %}
                    <!-- Для отчетов без параметров -->
                    <a href="{{ report.url }}" class="btn btn-{{ report.color }} btn-sm w-100">
                        <i class="bi bi-download"></i> Выгрузить отчет
                    </a>
                    {% endif %}
                {% else %}
                    <button class="btn btn-secondary btn-sm w-100" disabled>
                        <i class="bi bi-clock"></i> В разработке
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Модальное окно для выбора параметров -->
<div class="modal fade" id="reportParamsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Параметры отчета</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Подготовка отчета...</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <a href="#" class="btn btn-primary" id="confirmDownload">Скачать</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Обработка кнопок выгрузки отчетов
    document.querySelectorAll('.download-report').forEach(button => {
        button.addEventListener('click', function() {
            const reportId = this.dataset.reportId;
            const baseUrl = this.dataset.url;

            if (reportId === '2') {
                // Для отчета 2 получаем параметры
                const month = document.getElementById('month_2').value;
                const year = document.getElementById('year_2').value;

                const downloadUrl = `${baseUrl}?month=${month}&year=${year}`;
                window.location.href = downloadUrl;
            } else {
                window.location.href = baseUrl;
            }
        });
    });
});
</script>
{% endblock %}