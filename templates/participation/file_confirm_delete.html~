<!-- templates/participation/file_confirm_delete.html (исправляем ссылку на file_detail) -->
{% extends 'base.html' %}

{% block title %}Удаление файла - Путь к успеху{% endblock %}

{% block page_title %}Удаление файла{% endblock %}

{% block page_actions %}
    <a href="{% url 'participation:file_detail' file.pk %}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад к файлу
    </a>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления
                </h5>
            </div>
            <div class="card-body">
                <p class="lead">Вы действительно хотите удалить файл <strong>{{ file.original_name }}</strong>?</p>
                <p class="text-muted">Это действие нельзя будет отменить.</p>

                <div class="alert alert-info">
                    <h6><i class="bi bi-info-circle"></i> Информация о файле</h6>
                    <ul>
                        <li><strong>Размер:</strong> {{ file.file_size|filesizeformat }}</li>
                        <li><strong>Тип:</strong> {{ file.mime_type }}</li>
                        <li><strong>Дата загрузки:</strong> {{ file.upload_date|date:"d.m.Y H:i" }}</li>
                        <li><strong>Загрузил:</strong> {{ file.uploaded_by.get_full_name|default:file.uploaded_by.username }}</li>
                        <li><strong>Участие:</strong> {{ file.participation.child.fio }} - {{ file.participation.event.name }}</li>
                    </ul>
                </div>

                <form method="post">
                    {% csrf_token %}
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Удалить файл
                        </button>
                        <a href="{% url 'participation:file_detail' file.pk %}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Отмена
                        </a>
                        <a href="{% url 'participation:detail' file.participation.pk %}" class="btn btn-info">
                            <i class="bi bi-eye"></i> Просмотреть участие
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}