<!-- templates/participation/participation_detail.html (обновляем кнопки действий) -->
{% extends 'base.html' %}

{% block title %}Участие - {{ participation.child.fio }} - Путь к успеху{% endblock %}

{% block page_title %}Информация об участии{% endblock %}

{% block page_actions %}
    <a href="{% url 'participation:list' %}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
    {% if can_edit_participation %}
        <a href="{% url 'participation:update' participation.pk %}" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Редактировать
        </a>
    {% endif %}
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Основная информация</h5>
            </div>
            <div class="card-body">
                <table class="table">
                    <tr>
                        <th>Ребенок:</th>
                        <td>
                            <a href="{% url 'children:detail' participation.child.pk %}">{{ participation.child.fio }}</a>
                        </td>
                    </tr>
                    <tr>
                        <th>Студия:</th>
                        <td>{{ participation.enrollment.studio.name }}</td>
                    </tr>
                    <tr>
                        <th>Направление:</th>
                        <td>{{ participation.enrollment.direction.name }}</td>
                    </tr>
                    <tr>
                        <th>Педагог:</th>
                        <td>{{ participation.enrollment.teacher }}</td>
                    </tr>
                    <tr>
                        <th>Конкурс:</th>
                        <td>{{ participation.event.name }}</td>
                    </tr>
                    <tr>
                        <th>Результат:</th>
                        <td>
                            {% if participation.result_type %}
                                <span class="badge bg-success">{{ participation.result_type.name }}</span>
                            {% elif participation.custom_result %}
                                <span class="badge bg-warning">{{ participation.custom_result }}</span>
                            {% else %}
                                <span class="badge bg-secondary">Без результата</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Дата отчета:</th>
                        <td>{{ participation.report_date|date:"d.m.Y" }}</td>
                    </tr>
                    <tr>
                        <th>Дата создания:</th>
                        <td>{{ participation.created_at|date:"d.m.Y H:i" }}</td>
                    </tr>
                    <tr>
                        <th>Последнее обновление:</th>
                        <td>{{ participation.updated_at|date:"d.m.Y H:i" }}</td>
                    </tr>
                    {% if participation.created_by %}
                    <tr>
                        <th>Зарегистрировал:</th>
                        <td>{{ participation.created_by.get_full_name|default:participation.created_by.username }}</td>
                    </tr>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Действия</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{% url 'participation:list' %}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Назад к списку
                    </a>
                    {% if can_edit_participation %}
                        <a href="{% url 'participation:update' participation.pk %}" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Редактировать
                        </a>
                        <a href="{% url 'participation:delete' participation.pk %}" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Удалить
                        </a>
                    {% endif %}
                    <a href="{% url 'children:detail' participation.child.pk %}" class="btn btn-info">
                        <i class="bi bi-person"></i> Карточка ребенка
                    </a>
                    <a href="{% url 'events:detail' participation.event.pk %}" class="btn btn-success">
                        <i class="bi bi-trophy"></i> Карточка конкурса
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Файлы участия -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-files"></i> Прикрепленные файлы
                    {% with files_count=participation.uploadedfile_set.count %}
                        {% if files_count > 0 %}
                            <span class="badge bg-primary float-end">{{ files_count }}</span>
                        {% endif %}
                    {% endwith %}
                </h5>
            </div>
            <div class="card-body">
                {% with files=participation.uploadedfile_set.all %}
                    {% if files %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Имя файла</th>
                                        <th>Тип</th>
                                        <th>Размер</th>
                                        <th>Дата загрузки</th>
                                        <th>Загрузил</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for file in files %}
                                        <tr>
                                            <td>
                                                <i class="bi {% if file.is_image %}bi-image{% elif file.is_pdf %}bi-file-pdf{% else %}bi-file{% endif %}"></i>
                                                {{ file.original_name }}
                                            </td>
                                            <td>
                                                {% if file.is_image %}
                                                    <span class="badge bg-info">Изображение</span>
                                                {% elif file.is_pdf %}
                                                    <span class="badge bg-danger">PDF</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Файл</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ file.file_size|filesizeformat }}</td>
                                            <td>{{ file.upload_date|date:"d.m.Y H:i" }}</td>
                                            <td>{{ file.uploaded_by.get_full_name|default:file.uploaded_by.username }}</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <!-- Просмотр файла в браузере -->
                                                    <a href="{% url 'participation:view_file' file.pk %}"
                                                       class="btn btn-sm btn-outline-info"
                                                       title="Просмотр в браузере"
                                                       target="_blank">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
<!--                                                    &lt;!&ndash; Скачивание файла &ndash;&gt;-->
<!--                                                    <a href="{% url 'participation:download_file' file.pk %}"-->
<!--                                                       class="btn btn-sm btn-outline-success"-->
<!--                                                       title="Скачать">-->
<!--                                                        <i class="bi bi-download"></i>-->
<!--                                                    </a>-->
                                                    {% if can_edit_participation %}
                                                        <!-- Редактирование файла -->
                                                        <a href="{% url 'participation:file_update' file.pk %}"
                                                           class="btn btn-sm btn-outline-warning"
                                                           title="Редактировать">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <!-- Удаление файла -->
                                                        <a href="{% url 'participation:file_delete' file.pk %}"
                                                           class="btn btn-sm btn-outline-danger"
                                                           title="Удалить">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted">Файлы не прикреплены</p>
                    {% endif %}

                    {% if can_edit_participation %}
                        <div class="mt-3">
                            <a href="{% url 'participation:file_create' %}?participation={{ participation.pk }}"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-file-earmark-plus"></i> Прикрепить файл
                            </a>
                        </div>
                    {% endif %}
                {% endwith %}
            </div>
        </div>
    </div>
</div>
{% endblock %}